instance Balanced_Diet { 

	 domain = Balanced_Diet;

	 objects {
		 xpos : { x1, x2, x3, x4, x5 };
		 ypos : { y1, y2, y3, y4, y5 };
		 player : { alex };
		 healthy_food : { fruit, vegetable, protein_bar };
		 unhealthy_food : { snack };
		 area : { balanced_meal_area };
	 };

	 non-fluents {
		 ADJACENT-LEFT(x2, x1);
		 ADJACENT-LEFT(x3, x2);
		 ADJACENT-LEFT(x4, x3);
		 ADJACENT-LEFT(x5, x4);
		 ADJACENT-RIGHT(x1, x2);
		 ADJACENT-RIGHT(x2, x3);
		 ADJACENT-RIGHT(x3, x4);
		 ADJACENT-RIGHT(x4, x5);
		 ADJACENT-UP(y2, y1);
		 ADJACENT-UP(y3, y2);
		 ADJACENT-UP(y4, y3);
		 ADJACENT-UP(y5, y4);
		 ADJACENT-DOWN(y1, y2);
		 ADJACENT-DOWN(y2, y3);
		 ADJACENT-DOWN(y3, y4);
		 ADJACENT-DOWN(y4, y5);
		 healthy_food-x(fruit, x3);
		 healthy_food-y(fruit, y1);
		 healthy_food-x(vegetable, x4);
		 healthy_food-y(vegetable, y3);
		 healthy_food-x(protein_bar, x2);
		 healthy_food-y(protein_bar, y4);
		 unhealthy_food-x(snack, x1);
		 unhealthy_food-y(snack, y3);
		 area-x(balanced_meal_area, x4);
		 area-y(balanced_meal_area, y4);
	 };

	 init-state {
		 player-x(alex, x2);
		 player-y(alex, y2);
		 ~is_collected_healthy_food(fruit);
		 ~is_collected_healthy_food(vegetable);
		 ~is_collected_healthy_food(protein_bar);
		 ~is_collected_unhealthy_food(snack);
		 meals_assembled = 0;
		 ~is_meal_prepared_area(balanced_meal_area);
	 };

max-nondef-actions = 1;
horizon = 100;
discount = 0.80 ;
}

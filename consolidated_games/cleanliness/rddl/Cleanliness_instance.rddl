instance Cleanliness { 

	 domain = Cleanliness;

	 objects {
		 xpos : { x1, x2, x3, x4, x5 };
		 ypos : { y1, y2, y3, y4, y5 };
		 player : { eco_elara };
		 pollutants : { grime_gremlin };
	 };

	 non-fluents {
		 ADJACENT-LEFT(x2, x1);
		 ADJACENT-LEFT(x3, x2);
		 ADJACENT-LEFT(x4, x3);
		 ADJACENT-LEFT(x5, x4);
		 ADJACENT-RIGHT(x1, x2);
		 ADJACENT-RIGHT(x2, x3);
		 ADJACENT-RIGHT(x3, x4);
		 ADJACENT-RIGHT(x4, x5);
		 ADJACENT-UP(y2, y1);
		 ADJACENT-UP(y3, y2);
		 ADJACENT-UP(y4, y3);
		 ADJACENT-UP(y5, y4);
		 ADJACENT-DOWN(y1, y2);
		 ADJACENT-DOWN(y2, y3);
		 ADJACENT-DOWN(y3, y4);
		 ADJACENT-DOWN(y4, y5);
		 pollutants-x(grime_gremlin, x3);
		 pollutants-y(grime_gremlin, y3);
	 };

	 init-state {
		 player-x(eco_elara, x1);
		 player-y(eco_elara, y1);
		 ~is_cleaned_pollutants(grime_gremlin);
		 pollution_level = 5;
	 };

max-nondef-actions = 1;
horizon = 100;
discount = 0.80 ;
}

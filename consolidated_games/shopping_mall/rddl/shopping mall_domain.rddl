domain Shopping_Mall_Adventure{ 

requirements = {
        concurrent,           
        reward-deterministic 
    };

types {
   xpos : object ;
   ypos : object ;
   player : object ;
   mall_staff : object ;
   mall_shoppers : object ;
   mall_objectives : object ;
};

pvariables {
ADJACENT-LEFT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-RIGHT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-UP(ypos,ypos) : { non-fluent , bool , default=false } ;
ADJACENT-DOWN(ypos,ypos) : { non-fluent , bool , default=false } ;
move-left-player(player) : { action-fluent , bool , default=false } ;
move-right-player(player) : { action-fluent , bool , default=false } ;
move-up-player(player) : { action-fluent , bool , default=false } ;
move-down-player(player) : { action-fluent , bool , default=false } ;
has-moved-player(player) : { state-fluent , bool , default=false } ;
player-x(player,xpos) : { state-fluent , bool , default=false } ;
player-y(player,ypos) : { state-fluent , bool , default=false } ;
mall_staff-x(mall_staff,xpos) : { non-fluent , bool , default=false } ;
mall_staff-y(mall_staff,ypos) : { non-fluent , bool , default=false } ;
mall_shoppers-x(mall_shoppers,xpos) : { non-fluent , bool , default=false } ;
mall_shoppers-y(mall_shoppers,ypos) : { non-fluent , bool , default=false } ;
mall_objectives-x(mall_objectives,xpos) : { non-fluent , bool , default=false } ;
mall_objectives-y(mall_objectives,ypos) : { non-fluent , bool , default=false } ;
items_collected : { state-fluent , int , default=0 } ;
events_participated : { state-fluent , int , default=0 } ;
reputation_score : { state-fluent , int , default=0 } ;
list_completed : { state-fluent , bool , default=false } ;
collect_item-player-mall_objectives(player,mall_objectives) : { action-fluent , bool , default=false } ;
engage_event-player-mall_staff(player,mall_staff) : { action-fluent , bool , default=false } ;
interact-player-mall_shoppers(player,mall_shoppers) : { action-fluent , bool , default=false } ;
navigate_escalator-player-mall_staff(player,mall_staff) : { action-fluent , bool , default=false } ;
};

cpfs {
player-x'(?player,?xpos) = if (move-left-player( ?player)  & player-x( ?player, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-LEFT(?xpos, ?x2)] )  then true
 else if (move-left-player( ?player)  & exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then true
 else if (move-left-player( ?player)  & ~exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then false
 else if (move-right-player( ?player)  & player-x( ?player, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-RIGHT(?xpos, ?x2)] )  then true
 else if (move-right-player( ?player)  & exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then true
 else if (move-right-player( ?player)  & ~exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then false
 else player-x(?player, ?xpos)
;

player-y'(?player,?ypos) = if (move-up-player( ?player)  & player-y( ?player, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-UP(?ypos, ?y2)] )  then true
 else if (move-up-player( ?player)  & exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then true
 else if (move-up-player( ?player)  & ~exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then false
 else if (move-down-player( ?player)  & player-y( ?player, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-DOWN(?ypos, ?y2)] )  then true
 else if (move-down-player( ?player)  & exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then true
 else if (move-down-player( ?player)  & ~exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then false
 else player-y(?player, ?ypos)
;

has-moved-player'(?player) = move-left-player(?player) | move-right-player(?player) | move-up-player(?player) | move-down-player(?player)
;

items_collected' = if (exists_{?player:player, ?mall_objectives:mall_objectives} [ collect_item-player-mall_objectives(?player, ?mall_objectives) & items_collected < 5 & exists_{?x:xpos} [player-x(?player, ?x) & mall_objectives-x(?mall_objectives, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & mall_objectives-y(?mall_objectives, ?y)] ] )  then items_collected + 1
 else items_collected
;

events_participated' = if (exists_{?player:player, ?mall_staff:mall_staff} [ engage_event-player-mall_staff(?player, ?mall_staff) & events_participated < 3 & exists_{?x:xpos} [player-x(?player, ?x) & mall_staff-x(?mall_staff, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & mall_staff-y(?mall_staff, ?y)] ] )  then events_participated + 1
 else events_participated
;

reputation_score' = if (exists_{?player:player, ?mall_shoppers:mall_shoppers} [ interact-player-mall_shoppers(?player, ?mall_shoppers) & reputation_score < 15 & exists_{?x:xpos} [player-x(?player, ?x) & mall_shoppers-x(?mall_shoppers, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & mall_shoppers-y(?mall_shoppers, ?y)] ] )  then reputation_score + 1
 else if (exists_{?player:player, ?mall_staff:mall_staff} [ navigate_escalator-player-mall_staff(?player, ?mall_staff) & items_collected == 5 & events_participated == 3 & exists_{?x:xpos} [player-x(?player, ?x) & mall_staff-x(?mall_staff, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & mall_staff-y(?mall_staff, ?y)] & reputation_score >= 5 ] )  then 2 * reputation_score
 else reputation_score
;

list_completed' = if (exists_{?player:player, ?mall_staff:mall_staff} [ navigate_escalator-player-mall_staff(?player, ?mall_staff) & items_collected == 5 & events_participated == 3 & exists_{?x:xpos} [player-x(?player, ?x) & mall_staff-x(?mall_staff, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & mall_staff-y(?mall_staff, ?y)] & reputation_score >= 5 ] )  then true
 else list_completed
;

};

action-preconditions {
forall_{?player:player}[
            move-left-player(?player) => exists_{?x1:xpos, ?x2:xpos}[player-x(?player, ?x1) & ADJACENT-LEFT(?x1, ?x2)] 
        ];
forall_{?player:player}[
            move-right-player(?player) => exists_{?x1:xpos, ?x2:xpos}[player-x(?player, ?x1) & ADJACENT-RIGHT(?x1, ?x2)] 
        ];
forall_{?player:player}[
            move-up-player(?player) => exists_{?y1:ypos, ?y2:ypos}[player-y(?player, ?y1) & ADJACENT-UP(?y1, ?y2)] 
        ];
forall_{?player:player}[
            move-down-player(?player) => exists_{?y1:ypos, ?y2:ypos}[player-y(?player, ?y1) & ADJACENT-DOWN(?y1, ?y2)] 
        ];
};

reward = items_collected + events_participated * 2 + reputation_score;

// max_reward = 33.0

termination{
items_collected == 5  &  events_participated == 3  &  list_completed;
};
}

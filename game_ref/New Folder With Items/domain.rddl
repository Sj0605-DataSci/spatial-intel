domain Santas_Gift_Journey{ 

requirements = {
        concurrent,           
        reward-deterministic 
    };

types {
   xpos : object ;
   ypos : object ;
   santa_class : object ;
   present : object ;
   house : object ;
   stable : object ;
};

pvariables {
ADJACENT-LEFT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-RIGHT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-UP(ypos,ypos) : { non-fluent , bool , default=false } ;
ADJACENT-DOWN(ypos,ypos) : { non-fluent , bool , default=false } ;
move-left-santa_class(santa_class) : { action-fluent , bool , default=false } ;
move-right-santa_class(santa_class) : { action-fluent , bool , default=false } ;
move-up-santa_class(santa_class) : { action-fluent , bool , default=false } ;
move-down-santa_class(santa_class) : { action-fluent , bool , default=false } ;
has-moved-santa_class(santa_class) : { state-fluent , bool , default=false } ;
santa_class-x(santa_class,xpos) : { state-fluent , bool , default=false } ;
santa_class-y(santa_class,ypos) : { state-fluent , bool , default=false } ;
present-x(present,xpos) : { non-fluent , bool , default=false } ;
present-y(present,ypos) : { non-fluent , bool , default=false } ;
house-x(house,xpos) : { non-fluent , bool , default=false } ;
house-y(house,ypos) : { non-fluent , bool , default=false } ;
stable-x(stable,xpos) : { non-fluent , bool , default=false } ;
stable-y(stable,ypos) : { non-fluent , bool , default=false } ;
carrying_present_id : { state-fluent , int , default=0 } ;
is_collected(present) : { state-fluent , bool , default=false } ;
is_delivered(house) : { state-fluent , bool , default=false } ;
delivery_count : { state-fluent , int , default=0 } ;
stable_visited : { state-fluent , bool , default=false } ;
match-santa_class-present(santa_class,present) : { state-fluent , bool , default=false } ;
match-santa_class-house(santa_class,house) : { state-fluent , bool , default=false } ;
match-santa_class-stable(santa_class,stable) : { state-fluent , bool , default=false } ;
};

cpfs {
santa_class-x'(?santa_class,?xpos) = if (move-left-santa_class( ?santa_class)  & santa_class-x( ?santa_class, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-LEFT(?xpos, ?x2)] )  then true
 else if (move-left-santa_class( ?santa_class)  & exists_{?x2:xpos}[santa_class-x(?santa_class, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then true
 else if (move-left-santa_class( ?santa_class)  & ~exists_{?x2:xpos}[santa_class-x(?santa_class, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then false
 else if (move-right-santa_class( ?santa_class)  & santa_class-x( ?santa_class, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-RIGHT(?xpos, ?x2)] )  then true
 else if (move-right-santa_class( ?santa_class)  & exists_{?x2:xpos}[santa_class-x(?santa_class, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then true
 else if (move-right-santa_class( ?santa_class)  & ~exists_{?x2:xpos}[santa_class-x(?santa_class, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then false
 else santa_class-x(?santa_class, ?xpos)
;

santa_class-y'(?santa_class,?ypos) = if (move-up-santa_class( ?santa_class)  & santa_class-y( ?santa_class, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-UP(?ypos, ?y2)] )  then true
 else if (move-up-santa_class( ?santa_class)  & exists_{?y2:ypos}[santa_class-y(?santa_class, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then true
 else if (move-up-santa_class( ?santa_class)  & ~exists_{?y2:ypos}[santa_class-y(?santa_class, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then false
 else if (move-down-santa_class( ?santa_class)  & santa_class-y( ?santa_class, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-DOWN(?ypos, ?y2)] )  then true
 else if (move-down-santa_class( ?santa_class)  & exists_{?y2:ypos}[santa_class-y(?santa_class, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then true
 else if (move-down-santa_class( ?santa_class)  & ~exists_{?y2:ypos}[santa_class-y(?santa_class, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then false
 else santa_class-y(?santa_class, ?ypos)
;

has-moved-santa_class'(?santa_class) = move-left-santa_class(?santa_class) | move-right-santa_class(?santa_class) | move-up-santa_class(?santa_class) | move-down-santa_class(?santa_class)
;

match-santa_class-present'(?santa_class,?present) = 
                    exists_{?x : xpos, ?y : ypos} [  
                    santa_class-x'(?santa_class, ?x) & santa_class-y'(?santa_class, ?y) & present-x(?present, ?x) & present-y(?present, ?y) & has-moved-santa_class'(?santa_class)]
;

match-santa_class-house'(?santa_class,?house) = 
                    exists_{?x : xpos, ?y : ypos} [  
                    santa_class-x'(?santa_class, ?x) & santa_class-y'(?santa_class, ?y) & house-x(?house, ?x) & house-y(?house, ?y) & has-moved-santa_class'(?santa_class)]
;

match-santa_class-stable'(?santa_class,?stable) = 
                    exists_{?x : xpos, ?y : ypos} [  
                    santa_class-x'(?santa_class, ?x) & santa_class-y'(?santa_class, ?y) & stable-x(?stable, ?x) & stable-y(?stable, ?y) & has-moved-santa_class'(?santa_class)]
;

carrying_present_id' = if (exists_{?santa_class:santa_class, ?present:present}[ match-santa_class-present'(?santa_class, ?present) & ~is_collected(?present) & carrying_present_id == 0 ] )  then 1
 else if (exists_{?santa_class:santa_class, ?house:house}[ match-santa_class-house'(?santa_class, ?house) & carrying_present_id > 0 & ~is_delivered(?house) ] )  then 0
 else carrying_present_id
;

is_collected'(?present) = if (exists_{?santa_class:santa_class}[ match-santa_class-present'(?santa_class, ?present) & ~is_collected(?present) & carrying_present_id == 0 ] )  then true
 else is_collected(?present)
;

is_delivered'(?house) = if (exists_{?santa_class:santa_class}[ match-santa_class-house'(?santa_class, ?house) & carrying_present_id > 0 & ~is_delivered(?house) ] )  then true
 else is_delivered(?house)
;

delivery_count' = if (exists_{?santa_class:santa_class, ?house:house}[ match-santa_class-house'(?santa_class, ?house) & carrying_present_id > 0 & ~is_delivered(?house) ] )  then delivery_count + 1
 else delivery_count
;

stable_visited' = if (exists_{?santa_class:santa_class, ?stable:stable}[ match-santa_class-stable'(?santa_class, ?stable) & ~stable_visited ] )  then true
 else stable_visited
;

};

action-preconditions {
forall_{?santa_class:santa_class}[
            move-left-santa_class(?santa_class) => exists_{?x1:xpos, ?x2:xpos}[santa_class-x(?santa_class, ?x1) & ADJACENT-LEFT(?x1, ?x2)] 
        ];
forall_{?santa_class:santa_class}[
            move-right-santa_class(?santa_class) => exists_{?x1:xpos, ?x2:xpos}[santa_class-x(?santa_class, ?x1) & ADJACENT-RIGHT(?x1, ?x2)] 
        ];
forall_{?santa_class:santa_class}[
            move-up-santa_class(?santa_class) => exists_{?y1:ypos, ?y2:ypos}[santa_class-y(?santa_class, ?y1) & ADJACENT-UP(?y1, ?y2)] 
        ];
forall_{?santa_class:santa_class}[
            move-down-santa_class(?santa_class) => exists_{?y1:ypos, ?y2:ypos}[santa_class-y(?santa_class, ?y1) & ADJACENT-DOWN(?y1, ?y2)] 
        ];
};

reward = delivery_count + stable_visited;

termination{
delivery_count == 4;
};
}

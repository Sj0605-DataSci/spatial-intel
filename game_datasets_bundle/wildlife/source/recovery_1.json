{
    "topic": "Wildlife",
    "objective": "Players rescue endangered animals and restore ecosystems by solving puzzles and engaging with local communities.",
    "environment_description": "Diverse ecosystems including rainforests, savannahs, and oceans, with unique flora and fauna illustrating biodiversity challenges.",
    "domain": [
        {
            "name": "player1",
            "image_prompt": "A young wildlife conservationist wearing practical outdoor gear with a notebook and binoculars, showing a determined expression."
        },
        {
            "name": "elephant_companion",
            "image_prompt": "A curious young elephant with large, expressive eyes, exuding friendliness."
        },
        {
            "name": "tiger",
            "image_prompt": "A majestic tiger in a natural setting, emphasizing its beauty and vulnerability."
        },
        {
            "name": "panda",
            "image_prompt": "A gentle panda nestled among bamboo, representing conservation targets."
        },
        {
            "name": "rainforest",
            "image_prompt": "Lush rainforest setting filled with diverse plants and animals, illustrating the ecosystem's richness."
        },
        {
            "name": "savannah",
            "image_prompt": "Sprawling savannah with grasses and trees, highlighting the habitat of unique wildlife."
        },
        {
            "name": "ocean",
            "image_prompt": "Vibrant ocean scene with coral reefs, fish, and sea turtles, showcasing marine biodiversity."
        }
    ],
    "classes": [
        {
            "class_name": "player",
            "list_of_objects": [
                "player1"
            ],
            "isMovable": true
        },
        {
            "class_name": "companion",
            "list_of_objects": [
                "elephant_companion"
            ],
            "isMovable": false
        },
        {
            "class_name": "creature",
            "list_of_objects": [
                "tiger",
                "panda"
            ],
            "isMovable": false
        },
        {
            "class_name": "habitat",
            "list_of_objects": [
                "rainforest",
                "savannah",
                "ocean"
            ],
            "isMovable": false
        }
    ],
    "state_variables": [
        {
            "name": "animals_rescued",
            "type": "integer"
        },
        {
            "name": "habitat_restored",
            "type": "integer"
        },
        {
            "name": "is_rescued",
            "type": "boolean"
        },
        {
            "name": "is_restored",
            "type": "boolean"
        }
    ],
    "actions": [
        {
            "name": "Rescue(?player, ?creature)"
        },
        {
            "name": "Restore(?player, ?habitat)"
        }
    ],
    "transitions": [
        {
            "action": "Rescue(?player, ?creature)",
            "preconditions": [
                "animals_rescued < 2",
                "?player.x == ?creature.x",
                "?player.y == ?creature.y",
                "NOT is_rescued(?creature)"
            ],
            "effects": [
                "animals_rescued = animals_rescued + 1",
                "is_rescued(?creature) = true"
            ],
            "side_effects": [
                "ShowText(true, 'Animal rescued successfully!')"
            ]
        },
        {
            "action": "Restore(?player, ?habitat)",
            "preconditions": [
                "habitat_restored < 3",
                "?player.x == ?habitat.x",
                "?player.y == ?habitat.y",
                "NOT is_restored(?habitat)"
            ],
            "effects": [
                "habitat_restored = habitat_restored + 1",
                "is_restored(?habitat) = true"
            ],
            "side_effects": [
                "ShowText(true, 'Ecosystem restored!')"
            ]
        }
    ],
    "goal": "animals_rescued == 2 AND habitat_restored == 3",
    "reward": "animals_rescued + habitat_restored * 2",
    "max_reward": 8,
    "grid_size": {
        "x_size": 5,
        "y_size": 5
    },
    "initial_state_objects": [
        {
            "domain_object": "player1",
            "x": "1",
            "y": "1"
        },
        {
            "domain_object": "elephant_companion",
            "x": "2",
            "y": "2"
        },
        {
            "domain_object": "tiger",
            "x": "3",
            "y": "3"
        },
        {
            "domain_object": "panda",
            "x": "4",
            "y": "4"
        },
        {
            "domain_object": "rainforest",
            "x": "2",
            "y": "4"
        },
        {
            "domain_object": "savannah",
            "x": "3",
            "y": "2"
        },
        {
            "domain_object": "ocean",
            "x": "4",
            "y": "3"
        }
    ],
    "initial_state_variables": [
        {
            "name": "animals_rescued",
            "value": 0
        },
        {
            "name": "habitat_restored",
            "value": 0
        },
        {
            "name": "is_rescued(tiger)",
            "value": false
        },
        {
            "name": "is_rescued(panda)",
            "value": false
        },
        {
            "name": "is_restored(rainforest)",
            "value": false
        },
        {
            "name": "is_restored(savannah)",
            "value": false
        },
        {
            "name": "is_restored(ocean)",
            "value": false
        }
    ]
}
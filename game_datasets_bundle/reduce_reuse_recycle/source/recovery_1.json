{
    "topic": "Reduce Reuse Recycle",
    "objective": "Players must sort recyclable items and complete community projects to transform the city into an eco_friendly environment.",
    "environment_description": "A cityscape shifts from pollution to green. Features include separated recycle bins, community gardens, and renewable energy installations.",
    "domain": [
        {
            "name": "player_avatar",
            "image_prompt": "A young environmentalist in green attire, raising awareness about recycling within the community."
        },
        {
            "name": "plastic_bottle1",
            "image_prompt": "A transparent recyclable plastic bottle, ready to be sorted into recycling bins."
        },
        {
            "name": "glass_jar1",
            "image_prompt": "A clear glass jar with intricate engravings, designed for recycling."
        },
        {
            "name": "metal_can1",
            "image_prompt": "A shining metal can with a recyclable emblem, prepared for sorting."
        },
        {
            "name": "recycle_bin_plastic1",
            "image_prompt": "A blue bin labeled for plastic recyclables, neatly placed in the city."
        },
        {
            "name": "recycle_bin_glass1",
            "image_prompt": "A green bin designated for glass items, located near eco_friendly installations."
        },
        {
            "name": "recycle_bin_metal1",
            "image_prompt": "A silver bin marked for metal recyclables, encouraging proper waste management."
        }
    ],
    "classes": [
        {
            "class_name": "movable_player",
            "list_of_objects": [
                "player_avatar"
            ]
        },
        {
            "class_name": "recycle_item",
            "list_of_objects": [
                "plastic_bottle1",
                "glass_jar1",
                "metal_can1"
            ]
        },
        {
            "class_name": "recycle_bin",
            "list_of_objects": [
                "recycle_bin_plastic1",
                "recycle_bin_glass1",
                "recycle_bin_metal1"
            ]
        }
    ],
    "state_of_objects": [
        {
            "class_name": "movable_player",
            "isMovable": true
        },
        {
            "class_name": "recycle_item",
            "isMovable": false
        },
        {
            "class_name": "recycle_bin",
            "isMovable": false
        }
    ],
    "state_variables": [
        {
            "name": "is_sorted(recycle_item)",
            "type": "bool"
        },
        {
            "name": "items_sorted",
            "type": "integer"
        }
    ],
    "actions": [
        {
            "name": "MoveUp(movable_player)"
        },
        {
            "name": "MoveDown(movable_player)"
        },
        {
            "name": "MoveLeft(movable_player)"
        },
        {
            "name": "MoveRight(movable_player)"
        },
        {
            "name": "Sort(movable_player, recycle_item, recycle_bin)"
        }
    ],
    "transitions": [
        {
            "action": "MoveUp(?movable_player)",
            "preconditions": [
                "isMovable(?movable_player)",
                "?movable_player.y < grid_size.y"
            ],
            "effects": [
                "?movable_player.y = ?movable_player.y + 1"
            ],
            "side_effects": [
                "MoveImage(?movable_player, ?movable_player.x, ?movable_player.y - 1, ?movable_player.x, ?movable_player.y)"
            ]
        },
        {
            "action": "MoveDown(?movable_player)",
            "preconditions": [
                "isMovable(?movable_player)",
                "?movable_player.y > 1"
            ],
            "effects": [
                "?movable_player.y = ?movable_player.y - 1"
            ],
            "side_effects": [
                "MoveImage(?movable_player, ?movable_player.x, ?movable_player.y + 1, ?movable_player.x, ?movable_player.y)"
            ]
        },
        {
            "action": "MoveLeft(?movable_player)",
            "preconditions": [
                "isMovable(?movable_player)",
                "?movable_player.x > 1"
            ],
            "effects": [
                "?movable_player.x = ?movable_player.x - 1"
            ],
            "side_effects": [
                "MoveImage(?movable_player, ?movable_player.x + 1, ?movable_player.y, ?movable_player.x, ?movable_player.y)"
            ]
        },
        {
            "action": "MoveRight(?movable_player)",
            "preconditions": [
                "isMovable(?movable_player)",
                "?movable_player.x < grid_size.x"
            ],
            "effects": [
                "?movable_player.x = ?movable_player.x + 1"
            ],
            "side_effects": [
                "MoveImage(?movable_player, ?movable_player.x - 1, ?movable_player.y, ?movable_player.x, ?movable_player.y)"
            ]
        },
        {
            "action": "Sort(?movable_player, ?recycle_item, ?recycle_bin)",
            "preconditions": [
                "NOT is_sorted(?recycle_item)",
                "?movable_player.x == ?recycle_item.x",
                "?movable_player.y == ?recycle_item.y",
                "?recycle_item.x == ?recycle_bin.x",
                "?recycle_item.y == ?recycle_bin.y",
                "items_sorted < 3"
            ],
            "effects": [
                "is_sorted(?recycle_item) = true",
                "items_sorted = items_sorted + 1"
            ],
            "side_effects": [
                "MoveImage(?recycle_item, ?recycle_item.x, ?recycle_item.y, HIDDEN, HIDDEN)",
                "ShowText(true, 'Item sorted into the correct bin!')",
                "ShowText(items_sorted == 3, 'All items sorted successfully!')"
            ]
        }
    ],
    "goal": "items_sorted == 3",
    "reward": "items_sorted",
    "max_reward": 3,
    "grid_size": {
        "x_size": 3,
        "y_size": 3
    },
    "initial_state_objects": [
        {
            "domain_object": "player_avatar",
            "x": "1",
            "y": "1"
        },
        {
            "domain_object": "plastic_bottle1",
            "x": "1",
            "y": "2"
        },
        {
            "domain_object": "glass_jar1",
            "x": "2",
            "y": "2"
        },
        {
            "domain_object": "metal_can1",
            "x": "3",
            "y": "2"
        },
        {
            "domain_object": "recycle_bin_plastic1",
            "x": "1",
            "y": "3"
        },
        {
            "domain_object": "recycle_bin_glass1",
            "x": "2",
            "y": "3"
        },
        {
            "domain_object": "recycle_bin_metal1",
            "x": "3",
            "y": "3"
        }
    ],
    "initial_state_variables": [
        {
            "name": "is_sorted(plastic_bottle1)",
            "value": false
        },
        {
            "name": "is_sorted(glass_jar1)",
            "value": false
        },
        {
            "name": "is_sorted(metal_can1)",
            "value": false
        },
        {
            "name": "items_sorted",
            "value": 0
        }
    ]
}
domain Hospital_Heroes{ 

requirements = {
        concurrent,           
        reward-deterministic 
    };

types {
   xpos : object ;
   ypos : object ;
   player : object ;
   patient : object ;
   staff : object ;
   resources : object ;
};

pvariables {
ADJACENT-LEFT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-RIGHT(xpos,xpos) : { non-fluent , bool , default=false } ;
ADJACENT-UP(ypos,ypos) : { non-fluent , bool , default=false } ;
ADJACENT-DOWN(ypos,ypos) : { non-fluent , bool , default=false } ;
move-left-player(player) : { action-fluent , bool , default=false } ;
move-right-player(player) : { action-fluent , bool , default=false } ;
move-up-player(player) : { action-fluent , bool , default=false } ;
move-down-player(player) : { action-fluent , bool , default=false } ;
has-moved-player(player) : { state-fluent , bool , default=false } ;
player-x(player,xpos) : { state-fluent , bool , default=false } ;
player-y(player,ypos) : { state-fluent , bool , default=false } ;
patient-x(patient,xpos) : { non-fluent , bool , default=false } ;
patient-y(patient,ypos) : { non-fluent , bool , default=false } ;
staff-x(staff,xpos) : { non-fluent , bool , default=false } ;
staff-y(staff,ypos) : { non-fluent , bool , default=false } ;
resources-x(resources,xpos) : { non-fluent , bool , default=false } ;
resources-y(resources,ypos) : { non-fluent , bool , default=false } ;
patient_treated : { state-fluent , int , default=0 } ;
staff_energy : { state-fluent , int , default=0 } ;
resource_stock : { state-fluent , int , default=0 } ;
total_score : { state-fluent , int , default=0 } ;
treat_patient-player-patient(player,patient) : { action-fluent , bool , default=false } ;
restock_resources-player-resources(player,resources) : { action-fluent , bool , default=false } ;
coordinate_staff-player-staff(player,staff) : { action-fluent , bool , default=false } ;
};

cpfs {
player-x'(?player,?xpos) = if (move-left-player( ?player)  & player-x( ?player, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-LEFT(?xpos, ?x2)] )  then true
 else if (move-left-player( ?player)  & exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then true
 else if (move-left-player( ?player)  & ~exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-LEFT(?x2, ?xpos)] )  then false
 else if (move-right-player( ?player)  & player-x( ?player, ?xpos)  & ~exists_{?x2:xpos}[ADJACENT-RIGHT(?xpos, ?x2)] )  then true
 else if (move-right-player( ?player)  & exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then true
 else if (move-right-player( ?player)  & ~exists_{?x2:xpos}[player-x(?player, ?x2) & ADJACENT-RIGHT(?x2, ?xpos)] )  then false
 else player-x(?player, ?xpos)
;

player-y'(?player,?ypos) = if (move-up-player( ?player)  & player-y( ?player, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-UP(?ypos, ?y2)] )  then true
 else if (move-up-player( ?player)  & exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then true
 else if (move-up-player( ?player)  & ~exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-UP(?y2, ?ypos)] )  then false
 else if (move-down-player( ?player)  & player-y( ?player, ?ypos)  & ~exists_{?y2:ypos}[ADJACENT-DOWN(?ypos, ?y2)] )  then true
 else if (move-down-player( ?player)  & exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then true
 else if (move-down-player( ?player)  & ~exists_{?y2:ypos}[player-y(?player, ?y2) & ADJACENT-DOWN(?y2, ?ypos)] )  then false
 else player-y(?player, ?ypos)
;

has-moved-player'(?player) = move-left-player(?player) | move-right-player(?player) | move-up-player(?player) | move-down-player(?player)
;

patient_treated' = if (exists_{?player:player, ?patient:patient} [ treat_patient-player-patient(?player, ?patient) & exists_{?x:xpos} [player-x(?player, ?x) & patient-x(?patient, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & patient-y(?patient, ?y)] & patient_treated < 2 & total_score < 8 ] )  then patient_treated + 1
 else patient_treated
;

staff_energy' = if (exists_{?player:player, ?staff:staff} [ coordinate_staff-player-staff(?player, ?staff) & exists_{?x:xpos} [player-x(?player, ?x) & staff-x(?staff, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & staff-y(?staff, ?y)] & staff_energy < 3 & total_score < 8 ] )  then staff_energy + 1
 else staff_energy
;

resource_stock' = if (exists_{?player:player, ?resources:resources} [ restock_resources-player-resources(?player, ?resources) & exists_{?x:xpos} [player-x(?player, ?x) & resources-x(?resources, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & resources-y(?resources, ?y)] & resource_stock < 5 & total_score < 8 ] )  then resource_stock + 1
 else resource_stock
;

total_score' = if (exists_{?player:player, ?patient:patient} [ treat_patient-player-patient(?player, ?patient) & exists_{?x:xpos} [player-x(?player, ?x) & patient-x(?patient, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & patient-y(?patient, ?y)] & patient_treated < 2 & total_score < 8 ] )  then total_score + 1
 else if (exists_{?player:player, ?resources:resources} [ restock_resources-player-resources(?player, ?resources) & exists_{?x:xpos} [player-x(?player, ?x) & resources-x(?resources, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & resources-y(?resources, ?y)] & resource_stock < 5 & total_score < 8 ] )  then total_score + 1
 else if (exists_{?player:player, ?staff:staff} [ coordinate_staff-player-staff(?player, ?staff) & exists_{?x:xpos} [player-x(?player, ?x) & staff-x(?staff, ?x)] & exists_{?y:ypos} [player-y(?player, ?y) & staff-y(?staff, ?y)] & staff_energy < 3 & total_score < 8 ] )  then total_score + 1
 else total_score
;

};

action-preconditions {
forall_{?player:player}[
            move-left-player(?player) => exists_{?x1:xpos, ?x2:xpos}[player-x(?player, ?x1) & ADJACENT-LEFT(?x1, ?x2)] 
        ];
forall_{?player:player}[
            move-right-player(?player) => exists_{?x1:xpos, ?x2:xpos}[player-x(?player, ?x1) & ADJACENT-RIGHT(?x1, ?x2)] 
        ];
forall_{?player:player}[
            move-up-player(?player) => exists_{?y1:ypos, ?y2:ypos}[player-y(?player, ?y1) & ADJACENT-UP(?y1, ?y2)] 
        ];
forall_{?player:player}[
            move-down-player(?player) => exists_{?y1:ypos, ?y2:ypos}[player-y(?player, ?y1) & ADJACENT-DOWN(?y1, ?y2)] 
        ];
};

reward = total_score;

// max_reward = 8.0

termination{
total_score == 8;
};
}
